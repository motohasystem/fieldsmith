# kintone のドメイン (末尾スラッシュ不要)
KINTONE_BASE_URL=https://example.cybozu.com

# cybozu.com 共通管理 > 外部サービス連携 > OAuthクライアント で登録した値。
# 認可・トークンの各エンドポイント URL はクライアント登録時に払い出されるものをそのまま貼る。
KINTONE_OAUTH_CLIENT_ID=
KINTONE_OAUTH_CLIENT_SECRET=
KINTONE_OAUTH_REDIRECT_URI=https://app.example.com/oauth/callback
KINTONE_OAUTH_AUTHORIZATION_ENDPOINT=
KINTONE_OAUTH_TOKEN_ENDPOINT=

# Claude API のキー。`ant auth login` 済みなら未設定でも動く。
ANTHROPIC_API_KEY=
