# kintone のドメイン (末尾スラッシュ不要)
KINTONE_BASE_URL=https://example.cybozu.com

# ------------------------------------------------------------------
# 認証は 2 通りから選ぶ。どちらか一方を埋めればよい。
# 両方ある場合はパスワード認証を使う (KINTONE_AUTH で明示的に選べる)。
# ------------------------------------------------------------------

# [A] パスワード認証 — 事前の登録が要らない。`vck login` も不要。
#     アプリの作成権限を持つユーザーで。
KINTONE_USERNAME=
KINTONE_PASSWORD=

# [B] OAuth — パスワードを設定に置かずに済む。`vck login` で認可する。
#     cybozu.com 共通管理 > 外部サービス連携 > OAuthクライアント で登録した値。
#     認可・トークンの各エンドポイント URL は登録時に払い出されるものをそのまま貼る。
# KINTONE_OAUTH_CLIENT_ID=
# KINTONE_OAUTH_CLIENT_SECRET=
# KINTONE_OAUTH_REDIRECT_URI=https://example.com/callback
# KINTONE_OAUTH_AUTHORIZATION_ENDPOINT=
# KINTONE_OAUTH_TOKEN_ENDPOINT=

# どちらを使うか明示する場合 (password / oauth)
# KINTONE_AUTH=password

# Claude API のキー。plan / create / revise を使う場合だけ必要。
# `ant auth login` 済みなら未設定でも動く。
ANTHROPIC_API_KEY=
